# Echo WhatsApp Bot — Environment Variables
# Copy this file to .env and fill in your keys

# ── API Keys ──────────────────────────────────────────────────────────────
# Your Groq API key (free at https://console.groq.com)
# Used to verify Q&A quality before saving to Echo
GROQ_API_KEY=your_groq_api_key_here

# Your Gemini API key (free at https://aistudio.google.com)
# Used for multilingual (Hindi/Hinglish/English) synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# ── Backend Connection ────────────────────────────────────────────────────
# URL of your Flask Echo backend
# Development: http://127.0.0.1:5000
# Production (Railway): https://your-flask-service.up.railway.app
FLASK_URL=http://127.0.0.1:5000

# Public URL shown in clickable WhatsApp reply links
# Development: http://<your-lan-ip>:5000 (auto-detected)
# Production:  https://your-flask-service.up.railway.app
PUBLIC_URL=https://your-flask-service.up.railway.app

# ── Optional: 8-Digit Pairing Code (No QR Camera Needed!) ────────────────
# Set this to your bot's phone number with country code (e.g., 919876543210)
# to link WhatsApp using an 8-digit code instead of scanning a QR code.
PHONE_NUMBER=

# ── Paths (Railway Persistent Volume) ────────────────────────────────────
# On Railway: add a Volume mounted at /data, then set this.
# Locally: leave unset (defaults to ./auth_session)
AUTH_FOLDER=/data/auth_session
