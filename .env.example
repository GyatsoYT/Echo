# Copy this file to .env and fill in your API keys
# NEVER commit .env to git

# ── API Keys ────────────────────────────────────────────────────────────
# Get free key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── Flask ────────────────────────────────────────────────────────────────
# Any long random string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_string

# Set to "production" when deploying
FLASK_ENV=production

# ── Paths (Railway Persistent Volume) ────────────────────────────────────
# On Railway: add a Volume mounted at /data, then set these.
# Leave blank for local development (defaults to ./echo.db and ./static/audio)
DATABASE_PATH=/data/echo.db
UPLOAD_FOLDER=/data/audio
